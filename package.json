{
  "name": "gitinsight",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "test": "npm test -w apps/server",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
