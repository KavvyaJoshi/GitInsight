PORT=4000
# Leave empty in development to use an in-memory MongoDB (data is lost on restart).
MONGODB_URI=
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
LOCKOUT_MINUTES=15
# Google OAuth Web client ID (console.cloud.google.com). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Comma-separated emails that receive the Administrator role when they sign up.
ADMIN_EMAILS=
# Creates admin@gitinsight.dev / Admin@1234 and user@gitinsight.dev / User@1234 on startup.
SEED_DEMO_USERS=true
CORS_ORIGIN=http://localhost:5173
# Leave empty in development to use an in-process cache.
REDIS_URL=
# Optional GitHub token (no scopes needed). Raises the GitHub limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=
METADATA_TTL_SECONDS=900
ANALYTICS_TTL_SECONDS=3600
# AI insights (summary, trend, comparison). Leave the keys empty to show a "not configured" message instead.
# Free option: create a Gemini key at https://aistudio.google.com/apikey (no card needed).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Paid alternative: LLM_PROVIDER=anthropic with an ANTHROPIC_API_KEY from console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite (Gemini) or claude-opus-5-5 (Anthropic).
LLM_MODEL=
# Optional; defaults to 25000 ms for Gemini (free tier is slower) and 9000 ms for Anthropic.
AI_TIMEOUT_MS=
# Background jobs: alert checks every N minutes; in development they run inside the API process.
ALERT_INTERVAL_MINUTES=60
RUN_WORKER_IN_API=true
